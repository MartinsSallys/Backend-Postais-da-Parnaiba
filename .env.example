# =============================================================================
# Postais da Parnaiba — Environment Variables
# Copy this file to .env and fill in the values.
#   Local development without Docker: use localhost in DATABASE_URL
#   Docker (dev/prod): docker compose overrides DATABASE_URL to reach "db"
# =============================================================================

# --- Application -------------------------------------------------------------
PROJECT_NAME="Postais da Parnaiba API"
DEBUG=false

# --- Database ----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postais_da_parnaiba
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postais_da_parnaiba

# --- Security ----------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Admin (created automatically on first startup) --------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=static/uploads
PUBLIC_UPLOAD_PREFIX=/static/uploads
UPLOAD_MAX_SIZE=10485760

# --- CORS (JSON list of allowed origins) ------------------------------------
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:3000"]
